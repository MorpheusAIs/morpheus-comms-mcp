# Copy to .env (gitignored). Used by docker compose interpolation.

POSTGRES_USER=comms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=morpheus_comms

# Composed for the mcp service. Override if Postgres is not the sidecar.
DATABASE_URL=postgresql://comms:change-me@postgres:5432/morpheus_comms

# Agents must send Authorization: Bearer <this>
MCP_AUTH_TOKEN=change-me-too

MCP_HOST=0.0.0.0
MCP_PORT=8080

# Off by default. Comma-separated browser origins allowed to call /mcp and /api/tools.
MCP_CORS_ORIGINS=
# Optional Host-header allowlist (DNS-rebinding protection), e.g. comms.example.com
MCP_ALLOWED_HOSTS=

SLACK_DOMAIN=morpheus-qyv9301

# OpenAI-compatible embeddings (ingest.embed + semantic/hybrid search). 1024-d model.
EMBED_BASE_URL=https://api.mordiem.com/api/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-bge-m3
